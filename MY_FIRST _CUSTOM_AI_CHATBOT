selected_roles = input("Enter your AI personal assistant role")
print("you chose : ",selected_roles)

messages = [{ "role": selected_roles, "content":roles[selected_roles]}]



def chat(user_input):

    messages.append({"role":"user", "content": user_input}) #store user chat history

    response = client.chat.completions.create(
    model = 'qwen/qwen3.8-27b', #meta-llama/llama-prompt-guard-2-86m , openai/gpt-oss-20b, qwen/qwen3.8-27b
    max_tokens = 1024,
    messages = [{"role":"user","content":user_input}]
    )
    ai_response = response.choices[0].message.content

    messages.append({"role":"ai assistant", "content": ai_response}) #store ai response history

    return ai_response



